<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overseer_white"
    tools:context=".SubjectDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/subjectScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/detailSubjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Course name"
                android:textColor="@color/overseer_navy"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/detailSubjectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your learning space."
                android:textColor="@color/overseer_muted"
                android:textSize="14sp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/detailSubjectTitle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/materialsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDY MATERIALS"
                android:textColor="@color/overseer_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/lessonsContainer"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/lessonsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LESSONS"
                android:textColor="@color/overseer_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/detailSubjectSubtitle"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addLessonButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:text="Add lesson"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="@color/overseer_lime"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/overseer_navy"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/lessonsHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/lessonsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/addLessonButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addMaterialButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:text="Add material"
                android:textColor="@color/overseer_navy"
                android:textSize="14sp"
                app:backgroundTint="@color/overseer_lime"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/overseer_navy"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/materialsHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/materialsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/addMaterialButton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
