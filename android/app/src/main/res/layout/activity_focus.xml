<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overseer_white"
    tools:context=".FocusActivity">

    <TextView
        android:id="@+id/focusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Mode"
        android:textColor="@color/overseer_navy"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/focusSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay focused. One task at a time."
        android:textColor="@color/overseer_muted"
        android:textSize="14sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/focusTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textColor="@color/overseer_navy"
        android:textSize="64sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/focusSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <TextView
        android:id="@+id/focusStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready to focus"
        android:textColor="@color/overseer_muted"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/timerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startFocusButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start Focus"
        android:textColor="@color/overseer_navy"
        android:textSize="14sp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="32dp"
        app:backgroundTint="@color/overseer_lime"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/focusStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resetFocusButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reset Timer"
        android:textColor="@color/overseer_navy"
        android:textSize="14sp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="12dp"
        app:backgroundTint="#E5E5E5"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/startFocusButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/durationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOCUS DURATION"
        android:textColor="@color/overseer_navy"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/resetFocusButton"
        app:layout_constraintStart_toStartOf="parent" />

    <HorizontalScrollView
        android:id="@+id/durationScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/durationLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration5"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="5 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="@color/overseer_lime"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration15"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="15 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration25"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="25 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration30"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="30 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration45"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="45 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration60"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="60 min"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/durationCustom"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Custom"
                android:textColor="@color/overseer_navy"
                app:backgroundTint="#E5E5E5"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/currentTaskLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CURRENT TASK"
        android:textColor="@color/overseer_navy"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/durationScroll"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/currentTaskText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ready to focus?"
        android:textColor="@color/overseer_navy"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/currentTaskLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/focusOptionsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:text="Session details &amp; history  ↗"
        android:textColor="@color/overseer_navy"
        app:backgroundTint="@color/overseer_subtle"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/currentTaskText"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/overseer_surface"
        app:itemIconTint="@color/overseer_navy"
        app:itemTextColor="@color/overseer_navy"
        app:menu="@menu/bottom_navigation_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
