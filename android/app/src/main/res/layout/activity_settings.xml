<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/overseer_white">
    <EditText android:id="@+id/settingsName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Display name" />
    <EditText android:id="@+id/settingsTimezone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="IANA timezone" />
    <Button android:id="@+id/settingsSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Save preferences" />
    <Button android:id="@+id/settingsSignOut" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Sign out" />
</LinearLayout>
