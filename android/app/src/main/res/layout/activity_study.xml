<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overseer_white"
    tools:context=".StudyActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/studyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Study"
                android:textColor="@color/overseer_navy"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/studySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your learning space."
                android:textColor="@color/overseer_muted"
                android:textSize="14sp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/studyTitle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/studyToolsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDY TOOLS"
                android:textColor="@color/overseer_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/studySubtitle"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/studyToolsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/studyToolsHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/subjectsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR COURSES"
                android:textColor="@color/overseer_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/studyToolsContainer"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/addedSubjectsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/subjectsHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSubjectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:text="Add course"
                android:textColor="@color/overseer_navy"
                android:textSize="14sp"
                app:backgroundTint="@color/overseer_lime"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/overseer_navy"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/addedSubjectsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/overseer_surface"
        app:itemIconTint="@color/overseer_navy"
        app:itemTextColor="@color/overseer_navy"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
