<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overseer_white">

    <TextView
        android:id="@+id/scheduleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Schedule"
        android:textColor="@color/overseer_navy"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/scheduleSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keep track of your day."
        android:textColor="#777777"
        android:textSize="14sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/scheduleTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:gravity="center"
        android:textAlignment="center"
        android:id="@+id/scheduleDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MONDAY, NOVEMBER 17"
        android:textColor="@color/overseer_navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/scheduleSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/previousDayButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="‹"
        android:textSize="32sp"
        android:textColor="@color/overseer_navy"
        android:backgroundTint="#EAEAF0"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:layout_constraintTop_toTopOf="@id/scheduleDate"
        app:layout_constraintBottom_toBottomOf="@id/scheduleDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.1" />

    <Button
        android:id="@+id/nextDayButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="›"
        android:textSize="32sp"
        android:textColor="@color/overseer_navy"
        android:backgroundTint="#EAEAF0"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:layout_constraintTop_toTopOf="@id/scheduleDate"
        app:layout_constraintBottom_toBottomOf="@id/scheduleDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9" />

    <TextView
        android:id="@+id/todayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCHEDULED CLASSES"
        android:textColor="@color/overseer_navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/previousDayButton"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/selectedDayDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Here is what you have planned."
        android:textColor="#777777"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/todayLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/noClassesMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No classes scheduled for this day."
        android:textColor="#777777"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/selectedDayDescription"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/databaseClassCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E5E5"
        app:layout_constraintTop_toBottomOf="@id/selectedDayDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/overseer_lime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/databaseClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Database Management"
                    android:textColor="@color/overseer_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/databaseClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00 AM - 11:30 AM"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/databaseClassLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room 204"
                    android:textColor="#777777"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/programmingClassCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E5E5"
        app:layout_constraintTop_toBottomOf="@id/databaseClassCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/overseer_lime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/programmingClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programming 2"
                    android:textColor="@color/overseer_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/programmingClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1:00 PM - 2:30 PM"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/programmingClassLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computer Laboratory"
                    android:textColor="#777777"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemIconTint="@color/overseer_navy"
        app:itemTextColor="@color/overseer_navy"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
